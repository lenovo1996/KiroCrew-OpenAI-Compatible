# OpenAI Provider Gateway — environment variables
# Copy this file and fill in your values before starting the gateway.
#
# Required:
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Optional:
# OPENAI_MAX_TOKENS=8192
# OPENAI_CONTEXT_WINDOW=128000
# OPENAI_SYSTEM_PROMPT=""
# OPENAI_KNOWLEDGE_MODEL=""
# OPENAI_COMPACTION_THRESHOLD=80
# OPENAI_COMPACTION_KEEP_RECENT=6

# Embedding backend (replaces bundled llama.cpp model):
# EMBEDDING_BASE_URL=http://localhost:20128/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=nvidia/nvidia/nemotron-3-embed-1b
# EMBEDDING_DIM=2048

# Internal (do not change unless you know what you're doing):
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
